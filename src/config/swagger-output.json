  "paths": {
    "/api/v1/auth/companies/register": {
      "post": {
        "tags": ["Auth - Companies"],
        "summary": "Register a new company",
        "description": "Registers a new company account with the provided details.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "full_name": { "type": "string", "example": "John Doe" },
                "email": { "type": "string", "example": "john.doe@example.com" },
                "phone_number": { "type": "string", "example": "9876543210" },
                "country_code": { "type": "string", "example": "+91" },
                "role": { "type": "string", "example": "super_admin" },
                "password": { "type": "string", "example": "SecurePass@123" }
              },
              "required": ["full_name", "email", "phone_number", "country_code", "role", "password"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Company registered successfully" }
        }
      }
    },
    "/api/v1/auth/companies/refresh_access_token": {
      "post": {
        "tags": ["Auth - Companies"],
        "summary": "Refresh access token for company",
        "description": "Generates a new access token using the refresh token stored in cookies.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "type": "string",
            "required": true,
            "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        ],
        "responses": {
          "200": { "description": "Access token refreshed successfully" }
        }
      }
    },
    "/api/v1/auth/companies/change_password": {
      "post": {
        "tags": ["Auth - Companies"],
        "summary": "Change password for company user",
        "description": "Allows a company user to change their password.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "type": "string",
            "required": true,
            "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "new_password": { "type": "string", "example": "NewSecurePass@456" },
                "confirm_password": { "type": "string", "example": "NewSecurePass@456" },
                "email": { "type": "string", "example": "john.doe@example.com" },
                "user_name": { "type": "string", "example": "johndoe" }
              },
              "required": ["new_password", "confirm_password", "email"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Password changed successfully" }
        }
      }
    },
    "/api/v1/auth/companies/logout": {
      "post": {
        "tags": ["Auth - Companies"],
        "summary": "Logout company user",
        "description": "Logs out the currently authenticated company user.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "type": "string",
            "required": true,
            "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        ],
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
