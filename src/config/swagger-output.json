    "/api/v1/user/transporter/update_profile": {
      "patch": {
        "tags": ["User - Transporters"],
        "summary": "Update transporter profile",
        "description": "Updates the extended profile of the authenticated transporter including vehicle, bank, and availability details.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "type": "string",
            "required": true,
            "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "tier": { "type": "string", "example": "gold" },
                "verification": {
                  "type": "object",
                  "example": { "isVerified": true, "verifiedAt": "2024-01-10T08:00:00Z" }
                },
                "transportVehicle": {
                  "type": "object",
                  "example": { "make": "Tata", "model": "Ace", "year": 2021, "plate": "MH12CD5678", "type": "mini-truck" }
                },
                "bankDetails": {
                  "type": "object",
                  "example": { "accountHolderName": "John Doe", "accountNumber": "1234567890", "ifscCode": "HDFC0001234", "bankName": "HDFC Bank" }
                },
                "preferences": {
                  "type": "object",
                  "example": { "preferredRoutes": ["Delhi-Noida", "Delhi-Gurgaon"], "maxDistance": 50 }
                },
                "isAvailable": { "type": "boolean", "example": true },
                "isOnline": { "type": "boolean", "example": true },
                "certifications": {
                  "type": "array",
                  "example": [{ "name": "Safe Driving Certificate", "issuedBy": "MoRTH", "validUntil": "2026-12-31" }]
                },
                "emergencyContact": {
                  "type": "object",
                  "example": { "name": "Jane Doe", "phone": "9812345678", "relation": "spouse" }
                }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Transporter profile updated successfully" }
        }
      }
    },
