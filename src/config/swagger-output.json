                "defaultAddress": { "type": "string", "example": "Home" },
                "preferences": {
                  "type": "object",
                  "example": { "language": "en", "notifications": true }
                },
                "subscriptionPlan": { "type": "string", "example": "premium" },
                "paymentMethods": {
                  "type": "array",
                  "example": [{ "type": "upi", "upiId": "johndoe@upi" }]
                },
                "defaultPaymentMethod": { "type": "string", "example": "upi" }
              }
            }
          }
        ],
